---
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Illustration from "../../../components/Illustration.astro";
import AddToQuote from "../../../components/AddToQuote.astro";
import ProductCard from "../../../components/ProductCard.astro";
import CtaBand from "../../../components/CtaBand.astro";
import { getProducts, type Product } from "../../../data/catalog";
import { site, whatsappLink } from "../../../data/site";

export async function getStaticPaths() {
  // Products with an external `link` (e.g. IOL Simulator) have their own page.
  const products = (await getProducts()).filter((p) => !p.data.link);
  return products.map((product) => ({
    params: { category: product.data.category.id, slug: product.id },
    props: { product },
  }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const { Content } = await render(product);
const category = await getEntry(product.data.category);
const d = product.data;
const related = (await getProducts(d.category.id)).filter((p) => p.id !== product.id).slice(0, 3);
const specCols = ["", "sm:grid-cols-1", "sm:grid-cols-2", "sm:grid-cols-3"][Math.min(Object.keys(d.specs).length, 3)];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: d.title,
  description: d.summary,
  category: category?.data.title,
  brand: { "@type": "Brand", name: site.name },
  ...(d.variants.length > 0 && { sku: d.variants.map((v) => v.model).join(", ") }),
};
---

<BaseLayout title={d.title} description={d.summary} jsonLd={jsonLd}>
  <section class="border-b border-line">
    <div class="container-x py-8">
      <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li>
            <a href="/" class="hover:text-brand">
              Home
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/products" class="hover:text-brand">
              Products
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={`/products/${d.category.id}`} class="hover:text-brand">
              {category?.data.title}
            </a>
          </li>
        </ol>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-12">
        <!-- Visual -->
        <div class="lg:col-span-5">
          <div
            class:list={[
              "relative grid aspect-square place-items-center rounded-2xl border border-line",
              d.images[0] ? "bg-white" : "tech-grid bg-mist",
            ]}
          >
            {d.images[0] ? (
              <Image src={d.images[0]} alt={d.title} class="h-full w-full rounded-2xl object-contain p-6" />
            ) : (
              <Illustration name={d.illustration} class="size-3/5 text-navy" title={`${d.title} — technical drawing`} />
            )}
            {d.series && (
              <span class="absolute top-4 left-4 rounded border border-line bg-white px-2 py-0.5 font-mono text-xs text-muted">
                {d.series}
              </span>
            )}
          </div>
          {d.images.length > 1 && (
            <div class="mt-3 grid grid-cols-4 gap-3">
              {d.images.slice(1).map((img) => (
                <Image src={img} alt="" class="aspect-square rounded-lg border border-line object-cover" />
              ))}
            </div>
          )}
        </div>

        <!-- Info -->
        <div class="lg:col-span-7">
          {d.design && <p class="font-mono text-sm text-brand">{d.design}</p>}
          <h1 class="mt-2 text-3xl font-extrabold sm:text-4xl">{d.title}</h1>
          <p class="mt-4 text-lg leading-relaxed text-muted">{d.summary}</p>

          {d.placeholder && (
            <p class="mt-6 rounded-lg border border-brand/20 bg-brand-soft px-4 py-3 text-sm text-navy">
              Our detailed catalog for this line is being prepared. Tell us what you need and we'll send the available
              models and specifications.
            </p>
          )}

          <div class="mt-6 flex flex-wrap gap-3">
            <AddToQuote id={product.id} product={d.title} />
            <a
              href={whatsappLink(`Hello ${site.name}, I'm interested in: ${d.title}.`)}
              class="btn btn-outline"
              rel="noopener"
            >
              Ask on WhatsApp
            </a>
          </div>

          {Object.keys(d.specs).length > 0 && (
            <dl class:list={["mt-8 grid gap-px overflow-hidden rounded-xl border border-line bg-line", specCols]}>
              {Object.entries(d.specs).map(([k, v]) => (
                <div class="bg-white p-4">
                  <dt class="font-mono text-[0.7rem] tracking-wide text-steel uppercase">{k}</dt>
                  <dd class="mt-1 font-semibold text-navy">{v}</dd>
                </div>
              ))}
            </dl>
          )}

          <div class="prose-wf mt-8 max-w-2xl text-ink">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>

  {d.variants.length > 0 && (
    <section class="container-x py-14" id="models">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="eyebrow">Product line chart</p>
          <h2 class="mt-2 text-2xl font-extrabold">Available models</h2>
        </div>
        <p class="font-mono text-xs text-muted">{d.variants.length} models</p>
      </div>
      <div class="mt-6 overflow-x-auto rounded-xl border border-line">
        <table class="w-full min-w-[32rem] text-left text-sm">
          <thead class="bg-mist font-mono text-[0.72rem] tracking-wide text-muted uppercase">
            <tr>
              <th scope="col" class="px-4 py-3 font-medium">
                Model
              </th>
              {d.series && (
                <th scope="col" class="px-4 py-3 font-medium">
                  Series
                </th>
              )}
              <th scope="col" class="px-4 py-3 font-medium">
                Specification
              </th>
              <th scope="col" class="px-4 py-3 text-right font-medium">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {d.variants.map((v) => (
              <tr class="hover:bg-mist/60">
                <td class="px-4 py-3 font-mono font-semibold text-navy">{v.model}</td>
                {d.series && <td class="px-4 py-3 font-mono text-muted">{d.series}</td>}
                <td class="px-4 py-3 font-mono text-ink">
                  {v.spec}
                  {v.notes && <span class="ml-2 text-muted">{v.notes}</span>}
                </td>
                <td class="px-4 py-3 text-right">
                  <AddToQuote compact id={`${product.id}:${v.model}`} product={d.title} model={v.model} spec={v.spec} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="border-t border-line bg-mist py-14">
      <div class="container-x">
        <h2 class="text-2xl font-extrabold">More in {category?.data.title}</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>
