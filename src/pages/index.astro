---
import BaseLayout from "../layouts/BaseLayout.astro";
import Illustration from "../components/Illustration.astro";
import ProductCard from "../components/ProductCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { getCategories, getProducts } from "../data/catalog";

const categories = await getCategories();
const products = await getProducts();
const featured = products.filter((p) => p.data.featured && p.id !== "iol-simulator");
const counts = Object.fromEntries(
  categories.map((c) => [c.id, products.filter((p) => p.data.category.id === c.id).length]),
);
const modelCount = products.reduce((n, p) => n + p.data.variants.length, 0);

const pillars = [
  {
    n: "01",
    title: "Specified to the micron",
    text: "Every blade is listed by model, width and angle, so you order exactly what your technique needs.",
  },
  {
    n: "02",
    title: "Surgeon-focused range",
    text: "Ophthalmic micro-blades and LRI knives, plus surgical instruments and diagnostic equipment from one supplier.",
  },
  {
    n: "03",
    title: "Direct, fast quoting",
    text: "Build a list, send it in one click, and get pricing and lead times straight from our team by email or WhatsApp.",
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="tech-grid relative overflow-hidden border-b border-line bg-mist">
    <div class="container-x grid items-center gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-7">
        <p class="eyebrow">Surgical instruments &amp; ophthalmic blades</p>
        <h1 class="mt-3 text-4xl leading-[1.05] font-extrabold sm:text-5xl lg:text-6xl">
          Precision you can
          <br class="hidden sm:block" /> specify <span class="text-brand">to the micron.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
          Winfame Surgical supplies clinics, hospitals and distributors with ophthalmic knives, LRI knives, surgical
          instruments and diagnostic equipment — with clear specifications and direct quoting.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/products" class="btn btn-primary">
            Explore the catalog
          </a>
          <a href="/quote" class="btn btn-outline">
            Request a quote
          </a>
        </div>
        <dl class="mt-12 grid max-w-xl grid-cols-3 gap-4 border-t border-line pt-6 sm:gap-6">
          <div>
            <dt class="font-mono text-xs text-steel">Models listed</dt>
            <dd class="font-display text-xl font-extrabold whitespace-nowrap text-navy sm:text-3xl">{modelCount}+</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-steel">Widths</dt>
            <dd class="font-display text-xl font-extrabold whitespace-nowrap text-navy sm:text-3xl">
              0.75–3.2<span class="text-base">mm</span>
            </dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-steel">LRI depths</dt>
            <dd class="font-display text-xl font-extrabold whitespace-nowrap text-navy sm:text-3xl">
              300–650<span class="text-base">µm</span>
            </dd>
          </div>
        </dl>
      </div>

      <!-- Spec-sheet visual -->
      <div class="lg:col-span-5">
        <div class="relative rounded-2xl border border-line bg-white p-6 shadow-xl shadow-navy/5">
          <div class="flex items-center justify-between font-mono text-[0.7rem] text-steel">
            <span>WFZT · CLEAR CORNEA</span>
            <span>4 EDGE / 8 BEVEL</span>
          </div>
          <div class="relative mt-4 grid place-items-center rounded-xl bg-mist py-6">
            <Illustration name="clear-cornea" class="h-56 w-56 text-navy" title="Clear cornea blade profile" />
            <span class="absolute top-6 right-6 rounded bg-brand px-2 py-0.5 font-mono text-xs text-white">60°</span>
          </div>
          <table class="mt-4 w-full font-mono text-sm">
            <tbody class="divide-y divide-line">
              {[
                ["190CC", "1.00 mm"],
                ["191CC", "2.00 mm"],
                ["194CC", "2.40 mm"],
                ["161", "2.80 mm"],
              ].map(([m, s]) => (
                <tr>
                  <td class="py-2 font-semibold text-navy">{m}</td>
                  <td class="py-2 text-right text-muted">{s} · 60°</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="container-x py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Catalog</p>
        <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl">Product categories</h2>
      </div>
      <a href="/products" class="text-sm font-semibold text-brand hover:underline">
        View all products →
      </a>
    </div>
    <div class="mt-10 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c, i) => (
        <a
          href={c.id === "simulation" ? "/iol-simulator" : `/products/${c.id}`}
          class="group flex flex-col bg-white p-7 transition hover:bg-mist"
          data-reveal
        >
          <div class="flex items-start justify-between">
            <span class="font-mono text-xs text-steel">{String(i + 1).padStart(2, "0")}</span>
            <Illustration name={c.data.illustration} class="size-16 text-navy transition group-hover:text-brand" />
          </div>
          <h3 class="mt-4 text-xl font-bold">{c.data.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{c.data.summary}</p>
          <span class="mt-auto pt-5 font-mono text-xs text-brand">
            {counts[c.id]} {counts[c.id] === 1 ? "product line" : "product lines"} →
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured -->
  <section class="border-y border-line bg-mist py-20">
    <div class="container-x">
      <p class="eyebrow">Featured</p>
      <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl">Ophthalmic surgery essentials</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((p) => (
          <div data-reveal>
            <ProductCard product={p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="container-x py-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">Why Winfame</p>
        <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl">Built around how surgeons order.</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-3 lg:col-span-8">
        {pillars.map((p) => (
          <div class="border-t-2 border-navy pt-5" data-reveal>
            <span class="font-mono text-sm text-brand">{p.n}</span>
            <h3 class="mt-2 text-lg font-bold">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- IOL Simulator band (secondary) -->
  <section class="container-x pb-4">
    <div class="grid items-center gap-8 rounded-2xl border border-line p-6 sm:p-10 md:grid-cols-12">
      <div class="grid place-items-center rounded-xl bg-brand-soft py-8 md:col-span-4">
        <Illustration name="vr-headset" class="size-40 text-brand" title="VR headset" />
      </div>
      <div class="md:col-span-8">
        <p class="eyebrow !text-teal">Also from Winfame</p>
        <h2 class="mt-2 text-2xl font-extrabold sm:text-3xl">IOL Simulator — let patients see before they choose.</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted">
          A standalone VR headset that simulates vision with monofocal, trifocal and EDOF lenses — halos, glare and
          night driving included — while you guide the consultation from a tablet.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/iol-simulator" class="btn btn-outline">
            Discover IOL Simulator
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
