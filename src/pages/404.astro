---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="tech-grid bg-mist">
    <div class="container-x py-28 text-center">
      <p class="font-mono text-sm text-brand">ERROR 404</p>
      <h1 class="mt-3 text-4xl font-extrabold">This page is out of stock.</h1>
      <p class="mx-auto mt-4 max-w-md text-muted">The page you're looking for doesn't exist or has moved.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn btn-primary">
          Go home
        </a>
        <a href="/products" class="btn btn-outline">
          Browse products
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
