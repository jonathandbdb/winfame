---
// Button that adds a product (or a specific model) to the quote list.
// Clicks are handled once, via event delegation, by the script below.
interface Props {
  id: string;
  product: string;
  model?: string;
  spec?: string;
  compact?: boolean;
  class?: string;
}
const { id, product, model, spec, compact = false, class: className = "" } = Astro.props;
---

<button
  type="button"
  class:list={[
    compact
      ? "inline-flex items-center gap-1 rounded-md border border-line bg-white px-2.5 py-1 text-xs font-semibold text-navy transition hover:border-brand hover:text-brand"
      : "btn btn-primary",
    className,
  ]}
  data-add-quote
  data-id={id}
  data-product={product}
  data-model={model}
  data-spec={spec}
  aria-label={compact ? `Add model ${model ?? product} to quote` : undefined}
>
  <span data-label>{compact ? "+ Add" : "Add to quote"}</span>
</button>

<script>
  import { addToQuote } from "../scripts/quote";

  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-add-quote]");
    if (!btn) return;
    const { id, product, model, spec } = btn.dataset;
    if (!id || !product) return;
    addToQuote({ id, product, model, spec });
    const label = btn.querySelector<HTMLElement>("[data-label]");
    if (!label) return;
    const original = label.dataset.original ?? label.textContent ?? "";
    label.dataset.original = original;
    label.textContent = "✓ Added";
    window.setTimeout(() => (label.textContent = original), 1400);
  });
</script>
