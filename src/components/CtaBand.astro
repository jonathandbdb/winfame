---
import { site, whatsappLink } from "../data/site";

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Need pricing or a specific model?",
  text = "Send us your list and we'll reply with availability, lead times and a formal quotation.",
} = Astro.props;
---

<section class="container-x py-16">
  <div class="relative overflow-hidden rounded-2xl bg-navy px-6 py-12 text-white sm:px-12 md:flex md:items-center md:justify-between md:gap-10">
    <div class="pointer-events-none absolute inset-0 opacity-[0.07] [background-image:linear-gradient(#fff_1px,transparent_1px),linear-gradient(90deg,#fff_1px,transparent_1px)] [background-size:40px_40px]"></div>
    <div class="relative max-w-xl">
      <h2 class="text-2xl font-bold !text-white sm:text-3xl">{title}</h2>
      <p class="mt-3 text-white/70">{text}</p>
    </div>
    <div class="relative mt-8 flex flex-wrap gap-3 md:mt-0 md:shrink-0">
      <a href="/quote" class="btn bg-white text-navy hover:bg-brand-soft">
        Request a quote
      </a>
      <a
        href={whatsappLink(`Hello ${site.name}, I'd like information about your products.`)}
        class="btn btn-ghost-light"
        rel="noopener"
      >
        WhatsApp
      </a>
    </div>
  </div>
</section>
