---
import { getCollection } from "astro:content";
import Logo from "./Logo.astro";
import { site, whatsappLink } from "../data/site";

const categories = (await getCollection("categories")).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="bg-navy text-white/75">
  <div class="container-x grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-4">
      <Logo inverted />
      <p class="mt-4 max-w-xs text-sm leading-relaxed">{site.description}</p>
    </div>
    <div class="md:col-span-3">
      <p class="eyebrow !text-white/50">Products</p>
      <ul class="mt-3 space-y-2 text-sm">
        {categories.map((c) => (
          <li>
            <a href={`/products/${c.id}`} class="hover:text-white">
              {c.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="eyebrow !text-white/50">Company</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a href="/about" class="hover:text-white">
            About
          </a>
        </li>
        <li>
          <a href="/iol-simulator" class="hover:text-white">
            IOL Simulator
          </a>
        </li>
        <li>
          <a href="/quote" class="hover:text-white">
            Request a quote
          </a>
        </li>
        <li>
          <a href="/contact" class="hover:text-white">
            Contact
          </a>
        </li>
        <li>
          <a href="/privacy" class="hover:text-white">
            Privacy
          </a>
        </li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="eyebrow !text-white/50">Contact</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a href={`mailto:${site.email}`} class="break-all hover:text-white">
            {site.email}
          </a>
        </li>
        <li>
          <a href={whatsappLink()} class="hover:text-white" rel="noopener">
            WhatsApp {site.phone}
          </a>
        </li>
        <li>
          <a href={site.url} class="hover:text-white">
            winfamesurgical.com
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-white/50 md:flex-row md:justify-between">
      <p>
        © {year} {site.name}. All rights reserved.
      </p>
      <p class="max-w-2xl md:text-right">
        Products are intended for use by qualified healthcare professionals. Availability and regulatory status vary by
        country. Images are illustrative.
      </p>
    </div>
  </div>
</footer>
